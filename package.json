{
  "name": "ontime-salon-booking",
  "version": "1.0.0",
  "description": "WhatsApp multi-tenant salon booking system for Harare salons",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:init": "node -e \"require('./config/db').initDatabase()\"",
    "migrate:all": "node scripts/migrate-all.js",
    "migrate:db-reset": "node scripts/migrate-db-reset.js",
    "migrate:subscription-fees": "node scripts/migrate-subscription-fees.js",
    "migrate:subscriptions": "node scripts/migrate-subscriptions.js",
    "migrate:revenue-records": "node scripts/migrate-revenue-records.js"
  },
  "keywords": [
    "whatsapp",
    "salon",
    "booking",
    "twilio",
    "multi-tenant"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-session": "^1.19.0",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "pdfkit": "^0.18.0",
    "pg": "^8.11.3",
    "puppeteer": "^21.0.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "twilio": "^4.19.0",
    "whatsapp-web.js": "^1.26.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
